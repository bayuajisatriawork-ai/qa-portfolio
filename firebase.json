{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "input.css",
      "tailwind.config.js",
      "output.css",
      "firebase-function.js",
      "FIREBASE_SETUP.md",
      "DEPLOY.md",
      "FIX_DEPLOY.md",
      "README.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}